{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScrapeLens",
  "version": "0.1.0",
  "identifier": "app.scrapelens.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScrapeLens",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Inspecione sessões HTTP para scraping",
    "longDescription": "ScrapeLens inspeciona a sequência real de headers em sessões HTTP capturadas via CDP e NetLog, preservando duplicatas, ordem e proveniência.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
