{
  "name": "scrapelens-ui-slice",
  "private": true,
  "version": "0.1.1",
  "description": "UI slice of ScrapeLens with a synthetic session (demo) — preview before the fidelity gate",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:cookie-source": "tsx --tsconfig tsconfig.json scripts/cookie-source.test.tsx",
    "test:shortcuts": "tsx scripts/shortcuts.test.ts",
    "test:adapter": "tsx scripts/adapter-minimal.test.ts",
    "test:capture-url": "tsx scripts/capture-url.test.ts",
    "test:paged": "tsx scripts/paged-contract.test.ts",
    "test:list-view": "tsx scripts/list-view.test.ts",
    "test:not-sent": "tsx --tsconfig tsconfig.json scripts/not-sent.test.ts",
    "test:cookie-import": "tsx --tsconfig tsconfig.json scripts/cookie-import.test.ts",
    "test:platform-copy": "tsx --tsconfig tsconfig.json scripts/platform-copy.test.ts",
    "test:proxy-field": "tsx --tsconfig tsconfig.json scripts/proxy-field.test.ts",
    "test:export-proxy-notice": "tsx --tsconfig tsconfig.json scripts/export-proxy-notice.test.tsx",
    "shots": "node scripts/shoot.mjs",
    "perf": "node scripts/perf.mjs",
    "gen:demo": "node scripts/gen-demo-v1.mjs",
    "desktop:dev": "cd .. && ./app/node_modules/.bin/tauri dev",
    "desktop:build": "cd .. && ./app/node_modules/.bin/tauri build --bundles app",
    "test:export": "tsx --tsconfig tsconfig.json src/Export.test.tsx",
    "test": "npm run test:export && npm run test:cookie-source && npm run test:shortcuts && npm run test:adapter && npm run test:capture-url && npm run test:paged && npm run test:list-view && npm run test:not-sent && npm run test:cookie-import && npm run test:platform-copy && npm run test:proxy-field && npm run test:export-proxy-notice"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.64.1",
    "react-test-renderer": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
